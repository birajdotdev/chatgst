{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": ["bunx", "-y", "next-devtools-mcp@latest"],
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["bunx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "tanstack": {
      "type": "local",
      "command": ["bunx", "@tanstack/cli", "mcp"],
      "enabled": true
    }
  }
}
